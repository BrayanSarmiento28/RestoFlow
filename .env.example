# =====================================================================
# RestoFlow · Variables para Docker Compose
# Copie este archivo como ".env" (en la misma carpeta de docker-compose.yml):
#   Copy-Item .env.example .env
# y cambie las contraseñas. El archivo .env NO se sube a GitHub.
# =====================================================================

# Versión de las imágenes que se construyen (restoflow-backend:0.3.0, restoflow-frontend:0.3.0)
RESTOFLOW_VERSION=0.3.0

# Perfil de Spring Boot del backend: dev · preprod · prod
#  - preprod: Swagger encendido y menú de ejemplo (recomendado para probar)
#  - prod:    Swagger apagado, sin datos de ejemplo
SPRING_PROFILES_ACTIVE=preprod

# ---------- SQL Server ----------
# Contraseña del administrador "sa" del contenedor. SQL Server exige mínimo 8 caracteres
# con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=RestoFlow_Sa2026!
# Contraseña del usuario de la aplicación (restoflow_app)
DB_PASSWORD=RestoFlow_App2026!

# Solo para docker-compose.bd-local.yml (Docker usando el SQL Server instalado en el computador):
# contraseña de restoflow_app en ese SQL Server (la misma de application-local.yml) y su puerto.
DB_LOCAL_PASSWORD=
DB_LOCAL_PUERTO=1433

# ---------- Seguridad del backend ----------
# Clave para firmar los tokens JWT: mínimo 32 caracteres, larga y aleatoria
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas
# Administrador inicial que se crea en el primer arranque
ADMIN_EMAIL=admin@restoflow.com
ADMIN_PASSWORD=Admin2026*

# ---------- Correo de recuperación ----------
# consola: el código aparece en los registros del backend (docker compose logs backend)
CORREO_MODO=consola
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- API externa: Open Food Facts ----------
# Datos de un insumo por código de barras. Es gratuita y no pide clave.
OPENFOODFACTS_URL=https://world.openfoodfacts.org
# Zona horaria del backend (sin esto Docker usa la hora UTC)
TZ=America/Bogota

# ---------- Puertos en el computador ----------
FRONTEND_PUERTO=4200
BACKEND_PUERTO=8080
DB_PUERTO=14330
CORS_ORIGINS=http://localhost:4200
