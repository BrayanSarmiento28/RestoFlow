# =====================================================================
# RestoFlow · Variables para Docker Compose
# Copie este archivo como ".env" (en la misma carpeta de docker-compose.yml):
#   Copy-Item .env.example .env
# y cambie las contraseñas. El archivo .env NO se sube a GitHub.
# =====================================================================

# Versión de las imágenes que se construyen (restoflow-backend:1.1.1, restoflow-frontend:1.1.1)
RESTOFLOW_VERSION=1.1.1

# Perfil de Spring Boot del backend: dev · preprod · prod
#  - preprod: Swagger encendido y menú de ejemplo (recomendado para probar)
#  - prod:    Swagger apagado, sin datos de ejemplo
SPRING_PROFILES_ACTIVE=preprod

# Swagger en el perfil prod: false (recomendado para un restaurante real) o true (para mostrar el API, por
# ejemplo en la sustentación). Los perfiles dev y preprod siempre lo tienen encendido. Aunque se vea la
# documentación, cada operación sigue exigiendo iniciar sesión (token JWT).
SWAGGER_HABILITADO=false

# ---------- SQL Server ----------
# Contraseña del administrador "sa" del contenedor. SQL Server exige mínimo 8 caracteres
# con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=RestoFlow_Sa2026!
# Edición de SQL Server: Developer (solo desarrollo y pruebas) o Express (gratis y con licencia para producción;
# máximo 10 GB por base de datos). En el servidor de AWS use Express (ver docs/despliegue-aws.md).
MSSQL_PID=Developer
# Contraseña del usuario de la aplicación (restoflow_app)
DB_PASSWORD=RestoFlow_App2026!

# Solo para docker-compose.bd-local.yml (Docker usando el SQL Server instalado en el computador):
# contraseña de restoflow_app en ese SQL Server (la misma de application-local.yml) y su puerto.
DB_LOCAL_PASSWORD=
DB_LOCAL_PUERTO=1433

# ---------- Seguridad del backend ----------
# Clave para firmar los tokens JWT: mínimo 32 caracteres, larga y aleatoria
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas
# Administrador inicial que se crea en el primer arranque
ADMIN_EMAIL=admin@restoflow.com
ADMIN_PASSWORD=Admin2026*

# ---------- Correo de recuperación ----------
# consola: el código aparece en los registros del backend (docker compose logs backend)
CORREO_MODO=consola
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- API externa: Open Food Facts ----------
# Datos de un insumo por código de barras. Es gratuita y no pide clave.
OPENFOODFACTS_URL=https://world.openfoodfacts.org
# ---------- RestoFlow AI ----------
# Alertas anticipadas automáticas (cada hora): true o false
IA_ALERTAS_PROGRAMADAS=true
# Solo para demostraciones: true genera 3 semanas de ventas de ejemplo al arrancar (si casi no hay ventas)
IA_HISTORIAL_DEMO=false
# ---------- IA externa: Google Gemini (RestoFlow AI) ----------
# Clave gratuita: https://aistudio.google.com -> "Get API key". Péguela SOLO en su .env (nunca en GitHub ni en el chat).
# Si queda vacía, la campana y las recomendaciones funcionan con reglas y el chat del admin avisa que no hay IA.
GEMINI_API_KEY=
# Modelo gratuito de Gemini: Flash-Lite es el más rápido (cámbielo si Google publica otro)
GEMINI_MODELO=gemini-3.5-flash-lite
# Si el principal está saturado, sin cupo o tarda demasiado, se prueban estos en orden (separados por coma)
GEMINI_MODELOS_RESPALDO=gemini-3.8-flash
# ---------- Registro de actividad (logs en la base de datos) ----------
# Cada petición al API queda en la tabla registro_peticiones de SQL Server (se consulta desde SQL Server Management Studio)
REGISTRO_BD_HABILITADO=true
# Días que se conservan; cada madrugada (3:30 a. m.) se borra lo más antiguo
REGISTRO_BD_DIAS=30
# Zona horaria del backend (sin esto Docker usa la hora UTC)
TZ=America/Bogota

# ---------- Puertos en el computador ----------
FRONTEND_PUERTO=4200
BACKEND_PUERTO=8080
DB_PUERTO=14330
CORS_ORIGINS=http://localhost:4200
