        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="preparar: compartir datos">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Los hilos de los demás grupos leen estos datos con __P(...)
['tokenAdmin', 'tokenMesero', 'tokenCocina', 'meseroId', 'cocinaId', 'productos'].each { props.put(it, vars.get(it)) }
props.put('emailMesero', 'carga.mesero.' + vars.get('ejecucion') + '@restoflow.com')
props.put('clave', vars.get('claveTemporal'))
log.info('RestoFlow: prueba contra ' + vars.get('base') + ' con productos ' + vars.get('productos')
        + '. Cuentas temporales carga.mesero/carga.cocina.' + vars.get('ejecucion') + '@restoflow.com')
SampleResult.setResponseData('Datos compartidos con los grupos de la prueba', 'UTF-8')
</stringProp>
        </JSR223Sampler>
