        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Armar el pedido de la mesa">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">100</stringProp>
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Cada usuario virtual atiende SU mesa (101, 102, ...): una mesa ocupada no recibe otro pedido
def primera = (Parameters ?: '100') as int
def mesa = primera + ctx.getThreadNum() + 1
def ids = props.get('productos').split(',')
def azar = new Random()
def elegidos = [] as LinkedHashSet
(1 + azar.nextInt(3)).times { elegidos &lt;&lt; ids[azar.nextInt(ids.length)] }
def lineas = elegidos.collect { [productoId: it as long, cantidad: 1 + azar.nextInt(2), nota: null] }
vars.put('mesa', String.valueOf(mesa))
vars.put('cuerpoPedido', groovy.json.JsonOutput.toJson([numeroMesa: mesa, lineas: lineas, observaciones: 'Prueba de carga']))
</stringProp>
          </JSR223PreProcessor>
          <hashTree />
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Token de la sesión">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${__P(tokenMesero)}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree />
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Responde 201">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="201">201</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Se esperaba el código 201</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree />
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extraer pedidoId">
            <stringProp name="JSONPostProcessor.referenceNames">pedidoId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NO_ENCONTRADO</stringProp>
          </JSONPostProcessor>
          <hashTree />
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Si la mesa está ocupada, liberarla">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse

def base = vars.get('base')
def cliente = HttpClient.newBuilder().version(HttpClient.Version.HTTP_1_1).build()
def pedir = { String metodo, String ruta, Object cuerpo, String token -&gt;
    def publicador = cuerpo == null ? HttpRequest.BodyPublishers.noBody()
            : HttpRequest.BodyPublishers.ofString(JsonOutput.toJson(cuerpo))
    def peticion = HttpRequest.newBuilder(URI.create(base + ruta))
            .header('Content-Type', 'application/json')
            .header('Authorization', 'Bearer ' + token)
            .method(metodo, publicador)
            .build()
    cliente.send(peticion, HttpResponse.BodyHandlers.ofString())
}
// Lleva un pedido abierto hasta "pagado" desde el estado en que esté (para liberar su mesa)
def terminar = { pedido -&gt;
    def siguientes = [PENDIENTE: ['EN_PREPARACION', 'LISTO', 'ENTREGADO'], EN_PREPARACION: ['LISTO', 'ENTREGADO'],
                      LISTO: ['ENTREGADO'], ENTREGADO: []]
    (siguientes[pedido.estadoCocina] ?: []).each { estado -&gt;
        pedir('PATCH', '/cocina/pedidos/' + pedido.id + '/estado', [estado: estado], props.get('tokenCocina'))
    }
    pedir('PATCH', '/pedidos/' + pedido.id + '/pagar', [metodoPago: 'EFECTIVO'], props.get('tokenAdmin'))
}

// 409 = la mesa quedó ocupada por una vuelta anterior que no terminó (por ejemplo, un cobro con error):
// se cierra ese pedido para que la siguiente vuelta pueda usar la mesa. Esta petición sigue contando como error.
if (prev.getResponseCode() == '409') {
    def r = pedir('GET', '/pedidos?mesa=' + vars.get('mesa') + '&amp;estadoPedido=ABIERTO', null, props.get('tokenAdmin'))
    new JsonSlurper().parseText(r.body()).each { terminar(it) }
    log.info('Mesa ' + vars.get('mesa') + ' liberada')
}
</stringProp>
          </JSR223PostProcessor>
