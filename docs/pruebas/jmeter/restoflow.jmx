          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Lista de productos">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def ids = []
try {
    ids = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).collect { it.id }
} catch (Exception ignorada) { }
if (ids.isEmpty()) {
    prev.setSuccessful(false)
    prev.setResponseMessage('No hay productos disponibles en el menú: la prueba necesita al menos uno')
} else {
    vars.put('productos', ids.join(','))
}
</stringProp>
          </JSR223PostProcessor>
