      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Limpieza (cierra pedidos y desactiva cuentas)">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Bucle">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.delayedStart">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration" />
        <stringProp name="ThreadGroup.delay" />
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="TestPlan.comments">Al final: cierra los pedidos de prueba que quedaron abiertos y desactiva las cuentas temporales.</stringProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="limpiar">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters" />
          <stringProp name="filename" />
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpResponse

def base = vars.get('base')
def cliente = HttpClient.newBuilder().version(HttpClient.Version.HTTP_1_1).build()
def pedir = { String metodo, String ruta, Object cuerpo, String token -&gt;
    def publicador = cuerpo == null ? HttpRequest.BodyPublishers.noBody()
            : HttpRequest.BodyPublishers.ofString(JsonOutput.toJson(cuerpo))
    def peticion = HttpRequest.newBuilder(URI.create(base + ruta))
            .header('Content-Type', 'application/json')
            .header('Authorization', 'Bearer ' + token)
            .method(metodo, publicador)
            .build()
    cliente.send(peticion, HttpResponse.BodyHandlers.ofString())
}
// Lleva un pedido abierto hasta "pagado" desde el estado en que esté (para liberar su mesa)
def terminar = { pedido -&gt;
    def siguientes = [PENDIENTE: ['EN_PREPARACION', 'LISTO', 'ENTREGADO'], EN_PREPARACION: ['LISTO', 'ENTREGADO'],
                      LISTO: ['ENTREGADO'], ENTREGADO: []]
    (siguientes[pedido.estadoCocina] ?: []).each { estado -&gt;
        pedir('PATCH', '/cocina/pedidos/' + pedido.id + '/estado', [estado: estado], props.get('tokenCocina'))
    }
    pedir('PATCH', '/pedidos/' + pedido.id + '/pagar', [metodoPago: 'EFECTIVO'], props.get('tokenAdmin'))
}

if (!props.get('tokenAdmin')) {
    SampleResult.setResponseData('La preparación no terminó: no hay nada que limpiar', 'UTF-8')
    try { SampleResult.setIgnore() } catch (MissingMethodException ignorada) { }
    return
}
def abiertos = new JsonSlurper().parseText(pedir('GET', '/pedidos?estadoPedido=ABIERTO', null, props.get('tokenAdmin')).body())
def deLaPrueba = abiertos.findAll { String.valueOf(it.meseroId) == props.get('meseroId') }
deLaPrueba.each { terminar(it) }
[props.get('meseroId'), props.get('cocinaId')].findAll { it }.each { id -&gt;
    pedir('PATCH', '/usuarios/' + id + '/estado', [activa: false], props.get('tokenAdmin'))
}
def mensaje = 'Limpieza: ' + deLaPrueba.size() + ' pedidos de prueba cerrados y cuentas temporales desactivadas'
log.info(mensaje)
SampleResult.setResponseData(mensaje, 'UTF-8')
try { SampleResult.setIgnore() } catch (MissingMethodException ignorada) { }
</stringProp>
        </JSR223Sampler>
