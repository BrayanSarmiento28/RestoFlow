      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Pedidos completos (mesero → cocina → cobro)">
        <stringProp name="ThreadGroup.on_sample_error">startnextloop</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Bucle">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(vueltas,-1)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(usuarios.pedidos,1)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(subida,60)}</stringProp>
        <boolProp name="ThreadGroup.delayedStart">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
