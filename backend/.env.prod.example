# =====================================================================
# RestoFlow · Variables de entorno del backend · PRODUCCIÓN
# Copie como "backend/.env" SOLO en el servidor de producción.
# En producción todas estas variables son OBLIGATORIAS: si falta JWT_SECRET,
# ADMIN_PASSWORD o CORS_ORIGINS, la aplicación no arranca (a propósito).
# Swagger queda apagado y las tablas se crean solo con los scripts SQL.
# =====================================================================

SPRING_PROFILES_ACTIVE=prod

# ---------- Base de datos ----------
DB_HOST=servidor-produccion
DB_PORT=1433
DB_NAME=RestoFlowDB
DB_USER=restoflow_app
DB_PASSWORD=CONTRASENA_DE_PRODUCCION

# ---------- Correo ----------
CORREO_MODO=gmail
MAIL_USERNAME=correo_del_restaurante@gmail.com
MAIL_PASSWORD=CONTRASENA_DE_APLICACION_DE_GOOGLE

# ---------- Seguridad ----------
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_DE_PRODUCCION
ADMIN_EMAIL=admin@restoflow.com
ADMIN_PASSWORD=CAMBIAR_CONTRASENA_INICIAL
# Dirección pública del frontend (separar varias con coma)
CORS_ORIGINS=https://restoflow.ejemplo.com
