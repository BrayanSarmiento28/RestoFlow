# =====================================================================
# RestoFlow · Variables de entorno del backend · DESARROLLO
#
# Cómo usarlo: copie este archivo como "backend/.env" y escriba sus datos.
#   PowerShell:  Copy-Item .env.example .env
# El archivo .env NO se sube a GitHub (.gitignore). Las plantillas .env.*.example sí.
# Spring Boot lo lee al arrancar (spring.config.import en application.yml).
#
# Otros entornos: .env.preprod.example (pre-producción) y .env.prod.example (producción).
# =====================================================================

# Perfil de Spring Boot: dev · preprod · prod
SPRING_PROFILES_ACTIVE=dev

# ---------- Base de datos (SQL Server) ----------
DB_HOST=localhost
DB_PORT=1433
DB_NAME=RestoFlowDB
DB_USER=restoflow_app
DB_PASSWORD=ESCRIBA_AQUI_LA_CONTRASENA_DE_SQL_SERVER

# ---------- Correo de recuperación de contraseña ----------
# consola: el código se muestra en la consola · gmail: se envía por correo real
CORREO_MODO=consola
MAIL_USERNAME=su_correo@gmail.com
MAIL_PASSWORD=CONTRASENA_DE_APLICACION_DE_GOOGLE

# ---------- Seguridad ----------
# En desarrollo se usa una clave de prueba. Para usar una propia, quite el # (mínimo 32 caracteres)
# JWT_SECRET=una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@restoflow.com
ADMIN_PASSWORD=Admin2026*
