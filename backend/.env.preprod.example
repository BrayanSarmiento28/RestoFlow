# =====================================================================
# RestoFlow · Variables de entorno del backend · PRE-PRODUCCIÓN
# Copie como "backend/.env" en el equipo o servidor de pre-producción.
# =====================================================================

SPRING_PROFILES_ACTIVE=preprod

# ---------- Base de datos ----------
DB_HOST=servidor-preprod
DB_PORT=1433
DB_NAME=RestoFlowDB_Preprod
DB_USER=restoflow_app
DB_PASSWORD=CONTRASENA_DE_PREPRODUCCION

# ---------- Correo ----------
CORREO_MODO=gmail
MAIL_USERNAME=correo_del_restaurante@gmail.com
MAIL_PASSWORD=CONTRASENA_DE_APLICACION_DE_GOOGLE

# ---------- Seguridad ----------
# Clave larga y aleatoria (mínimo 32 caracteres), distinta a la de producción
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_DE_PREPRODUCCION
ADMIN_EMAIL=admin@restoflow.com
ADMIN_PASSWORD=CAMBIAR_CONTRASENA_INICIAL
# Dirección donde se publica el frontend de pre-producción
CORS_ORIGINS=http://localhost:4200
